@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-4">
    <h1 class="display-4">Superintendencia de Administración Tributaria (SAT)</h1>
    <p class="lead mt-3">
        Use los botones para enviar mensajes al API, consultar facturas,
        ver los resúmenes de IVA y por rango con sus gráficas, y descargar los reportes en PDF.
    </p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3 mt-3 mx-auto" style="max-width: 900px">
    <div class="col"><a class="btn btn-primary btn-lg w-100 py-3" asp-page="/EnviarMensaje">Enviar mensaje</a></div>
    <div class="col"><a class="btn btn-primary btn-lg w-100 py-3" asp-page="/ConsultarContribuyente">Consultar contribuyente</a></div>
    <div class="col"><a class="btn btn-primary btn-lg w-100 py-3" asp-page="/ResumenIva">Resumen IVA</a></div>
    <div class="col"><a class="btn btn-primary btn-lg w-100 py-3" asp-page="/ResumenRango">Resumen por rango</a></div>
    <div class="col"><a class="btn btn-primary btn-lg w-100 py-3" asp-page="/ReporteFechas">Reporte por fechas</a></div>
    <div class="col"><a class="btn btn-danger btn-lg w-100 py-3" asp-page="/Inicializar">Inicializar</a></div>
</div>